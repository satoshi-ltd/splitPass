{
  "manifest_version": 3,
  "name": "split/Pass Scanner",
  "version": "0.1.0",
  "description": "Scan SplitPass QR codes from the popup and fill saved passwords from an in-page site panel.",
  "icons": {
    "16": "assets/icon-extension-16.png",
    "32": "assets/icon-extension-32.png",
    "48": "assets/icon-extension-48.png",
    "128": "assets/icon-extension-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "split/Pass Scanner",
    "default_icon": {
      "16": "assets/icon-extension-16.png",
      "32": "assets/icon-extension-32.png",
      "48": "assets/icon-extension-48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/browser-api.js",
        "lib/totp.js",
        "lib/secret-item.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "item.css",
        "content.css",
        "assets/icon-extension.svg",
        "assets/icon-extension-32.png",
        "assets/fonts/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
