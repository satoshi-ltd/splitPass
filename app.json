{
  "expo": {
    "name": "SplitPass",
    "slug": "satoshi-ltd-splitpass",
    "owner": "satoshi-ltd",
    "scheme": "splitpass",
    "version": "1.4.24",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "icon": "./assets/ios-light.png",
      "bundleIdentifier": "com.satoshi-limited.splitpass",
      "buildNumber": "14",
      "usesIcloudStorage": false,
      "splash": {
        "image": "./assets/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5F1E8"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "$(PRODUCT_NAME) uses Face ID to unlock your encrypted vault."
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1E8"
      },
      "package": "com.satoshiltd.splitpass",
      "versionCode": 14,
      "splash": {
        "image": "./assets/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5F1E8"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d4863ee6-c3f5-46b2-ab09-0a13ee11711e"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) needs camera access to scan QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "$(PRODUCT_NAME) uses Face ID to unlock your encrypted vault."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "$(PRODUCT_NAME) needs NFC access to scan cards.",
          "selectIdentifiers": [
            "*"
          ],
          "systemCodes": [
            "*"
          ],
          "includeNdefEntitlement": false
        }
      ]
    ]
  }
}
